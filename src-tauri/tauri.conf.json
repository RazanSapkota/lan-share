{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LAN Share",
  "version": "0.3.0",
  "identifier": "com.lanshare.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "LAN Share",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "minWidth": 1020,
        "minHeight": 700
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
