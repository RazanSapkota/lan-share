{
  "name": "lan-share",
  "private": true,
  "version": "0.3.0",
  "description": "Rust + Tauri desktop app that shares media files and folders over the local network",
  "license": "MIT",
  "scripts": {
    "tauri:dev": "cargo run --manifest-path src-tauri/Cargo.toml",
    "tauri:build": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "version:set": "node tools/set-version.mjs"
  }
}
